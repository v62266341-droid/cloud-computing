// College Event Registration System
// Set Registration Status and Send Notification

// Set default registration status
input.Registration_Status = "Pending";

// Check for duplicate registration
existing = Event_Registration_Form[
    Register_Number == input.Register_Number
    && Event_Name == input.Event_Name
];

if(existing.count() > 0)
{
    alert "You have already registered for this event.";
    cancel submit;
}
else
{
    // Send notification email to event coordinator
    sendmail
    [
        from : zoho.adminuserid
        to : "coordinator@college.edu"
        subject : "New College Event Registration"
        message : "A new student registration has been received."
            + "<br><br><b>Student Name:</b> " + input.Student_Name
            + "<br><b>Register Number:</b> " + input.Register_Number
            + "<br><b>Department:</b> " + input.Department
            + "<br><b>Year:</b> " + input.Year
            + "<br><b>Event Name:</b> " + input.Event_Name
            + "<br><b>Participation Type:</b> " + input.Participation_Type
            + "<br><b>Contact Details:</b> " + input.Contact_Details
            + "<br><b>Registration Status:</b> Pending";
    ];
}
